aws_region    = "ap-south-1"
project_name  = "aegisops"
environment   = "dev"

# Change this to your actual public IP/CIDR. Find it from your network,
# then use x.x.x.x/32. Do not use 0.0.0.0/0 for SSH.
admin_cidr = "203.0.113.10/32"

# Create this EC2 key pair in ap-south-1 before applying Terraform.
key_name = "aegisops-key"

control_plane_instance_type = "t3.large"
worker_instance_type        = "t3.medium"
root_volume_size            = 30
